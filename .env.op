# .env.op — 1Password references for LOCAL tooling, injected via `op run`.
# Usage:  op run --env-file=.env.op -- <command>
# Contains references only (op://…), never secret values — safe to commit.
# Only secrets that (a) exist in the `homelab` vault and (b) are useful to a
# local CLI are kept. In-cluster-only app secrets and non-secrets were dropped
# (they belong in ESO / plain .env, not here). See notes at bottom.

### S3 / restic (garage/truenas) — for local aws / restic / rclone / mc
S3_ENDPOINT=op://homelab/shared.volsync-secrets/SECRET_S3_ENDPOINT
S3_ACCESS_KEY=op://homelab/shared.volsync-secrets/SECRET_S3_ACCESS_KEY
S3_SECRET_KEY=op://homelab/shared.volsync-secrets/SECRET_S3_SECRET_KEY
AWS_ACCESS_KEY_ID=op://homelab/shared.volsync-secrets/SECRET_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=op://homelab/shared.volsync-secrets/SECRET_S3_SECRET_KEY
# RESTIC_PASSWORD=op://homelab/shared.volsync-secrets/SECRET_RESTIC_PASSWORD

### NUT (UPS) — feeds ansible group_vars secret-gen / local nut checks
NUT_USER=op://homelab/observability.nut-exporter/NUT_EXPORTER_USERNAME
NUT_PASSWORD=op://homelab/observability.nut-exporter/NUT_EXPORTER_PASSWORD

### Cloudflare DNS API — for local flarectl / cf-terraforming / curl
CLOUDFLARE_TOKEN=op://homelab/network.external-dns/CF_API_TOKEN
CLOUDFLARE_ZONE_ID=op://homelab/network.external-dns/CF_ZONE_ID

### TrueNAS API (only stored under default.homepage fields)
TRUENAS_APIKEY=op://homelab/default.homepage/HOMEPAGE_VAR_TRUENAS_KEY
TRUENAS_IP=op://homelab/default.homepage/HOMEPAGE_VAR_TRUENAS_IP

### CloudNativePG — for local psql against the cluster DBs
DB_ROOT_PWD=op://homelab/database.postgres/password
